# Copia este archivo a .env y rellena tus valores (.env NO se sube a git).

# Base de datos real. Formato: postgresql://usuario:contraseña@host:5432/base
# Si la contraseña tiene caracteres especiales (@ / #), codifícalos (@ -> %40).
# En RDS añade ?sslmode=require al final.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/venison

# Base SOLO para tests. Su nombre debe terminar en _test: los tests la vacían.
TEST_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/venison_test

# Clave que deben enviar los clientes en la cabecera X-API-Key.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
